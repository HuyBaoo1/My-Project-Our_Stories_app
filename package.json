{
  "name": "our-stories",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings src tests scripts vite.config.ts vitest.config.ts playwright.config.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:rules": "node scripts/firebase-emulators.mjs rules",
    "test:e2e": "playwright test",
    "emulators": "node scripts/firebase-emulators.mjs start",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@radix-ui/react-slot": "1.5.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "13.2.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "firebase-tools": "15.34.2",
    "oxlint": "1.91.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
