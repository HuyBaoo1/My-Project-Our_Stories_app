# Public Firebase Web SDK configuration; replace with actual values from Firebase Console.
# These are not admin credentials. Protection still depends on Firestore Security Rules.
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=replace_me.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_me
VITE_FIREBASE_APP_ID=replace_me
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_me

# Never add service account JSON or private keys to Vite environment variables.
